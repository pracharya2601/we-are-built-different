# Application
APP_ENV=development

# Auth0 Regular Web Application
# Put these in .env.local, never in .env: Wrangler loads .env first and
# .env.local second, so a stray AUTH0_* key in .env silently shadow-fills any
# gap here and can pair one tenant's domain with another tenant's client.
AUTH0_DOMAIN=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_APP_BASE_URL=http://localhost:3000
AUTH0_SESSION_SECRET=replace-with-at-least-32-random-bytes
# AUTH0_AUDIENCE is OPTIONAL. Leave it empty to sign in with the ID token alone
# (token assertions stay empty; D1 membership roles still authorize everything).
# If you set it, it must be the identifier of an API that already exists in the
# tenant (Auth0 Dashboard -> Applications -> APIs -> Create API, RS256), matched
# byte for byte. A value that merely looks right fails every login at /authorize
# with "access_denied - Service not found", before the login form is ever shown.
# The identifier is an opaque ID; Auth0 never fetches it.
AUTH0_AUDIENCE=
AUTH0_ROLES_CLAIM=https://built-different.app/roles
AUTH0_PERMISSIONS_CLAIM=permissions

# Stripe sandbox for local development (never commit actual values)
# Use an sk_test_ key, the whsec_ value printed by `npm run stripe:listen`,
# and two distinct monthly recurring price_ IDs from the same sandbox.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLATFORM_LITE=
STRIPE_PRICE_PLATFORM_PRO=
STRIPE_PRODUCT_PLATFORM_LITE=
STRIPE_PRODUCT_PLATFORM_PRO=
BILLING_GRACE_PERIOD_SECONDS=259200
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Stripe appointment funding (separate from SaaS subscriptions)
STRIPE_APPOINTMENT_SECRET_KEY=
STRIPE_APPOINTMENT_WEBHOOK_SECRET=
STRIPE_APPOINTMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Cloudflare R2 image uploads
# The IMAGE_UPLOADS binding and environment-specific bucket name live in
# wrangler.jsonc. Local development uses Wrangler's local R2 simulation.
IMAGE_UPLOAD_MAX_BYTES=10485760

# Downstream file-metadata receiver
# Configure both values together. The receiver must treat the Idempotency-Key
# header as the delivery deduplication key.
FILE_METADATA_SERVICE_URL=
FILE_METADATA_SERVICE_TOKEN=

# Vapi outbound call automation
# Keep the API key, webhook token, and data-encryption key secret. Configure the
# Vapi Custom Credential to send: Authorization: Bearer <VAPI_WEBHOOK_TOKEN>.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_TOKEN=
VAPI_API_BASE_URL=https://api.vapi.ai
CALL_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
# Local-only authentication bypass. The runtime also requires
# APP_ENV=development and config/company.json features.authentication=false.
# Staging and production must not define this variable as true.
LOCAL_AUTH_BYPASS=false
