# Application
APP_ENV=development

# Auth0 Regular Web Application
AUTH0_DOMAIN=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_APP_BASE_URL=http://localhost:3000
AUTH0_SESSION_SECRET=replace-with-at-least-32-random-bytes
AUTH0_AUDIENCE=https://api.example.com/control-plane
AUTH0_ROLES_CLAIM=https://built-different.app/roles
AUTH0_PERMISSIONS_CLAIM=permissions

# Stripe sandbox for local development (never commit actual values)
# Use an sk_test_ key, the whsec_ value printed by `npm run stripe:listen`,
# and two distinct monthly recurring price_ IDs from the same sandbox.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLATFORM_LITE=
STRIPE_PRICE_PLATFORM_PRO=
STRIPE_PRODUCT_PLATFORM_LITE=
STRIPE_PRODUCT_PLATFORM_PRO=
BILLING_GRACE_PERIOD_SECONDS=259200
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Cloudflare R2 image uploads
# The IMAGE_UPLOADS binding and environment-specific bucket name live in
# wrangler.jsonc. Local development uses Wrangler's local R2 simulation.
IMAGE_UPLOAD_MAX_BYTES=10485760

# Downstream file-metadata receiver
# Configure both values together. The receiver must treat the Idempotency-Key
# header as the delivery deduplication key.
FILE_METADATA_SERVICE_URL=
FILE_METADATA_SERVICE_TOKEN=

# Vapi outbound call automation
# Keep the API key, webhook token, and data-encryption key secret. Configure the
# Vapi Custom Credential to send: Authorization: Bearer <VAPI_WEBHOOK_TOKEN>.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_TOKEN=
VAPI_API_BASE_URL=https://api.vapi.ai
CALL_DATA_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes
