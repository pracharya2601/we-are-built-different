{
  "name": "built-different-control-plane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --port ${PORT:-3000}",
    "test": "node --test tests/*.test.mjs",
    "test:build": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply built-different-local --local",
    "db:migrations:list:staging": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations list built-different-staging --remote --env staging",
    "db:migrate:staging": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply built-different-staging --remote --env staging",
    "deploy:staging:dry-run": "CLOUDFLARE_ENV=staging WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy --env staging --dry-run",
    "deploy:staging": "CLOUDFLARE_ENV=staging WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy --env staging",
    "stripe:listen": "stripe listen --events customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,customer.subscription.paused,customer.subscription.resumed --forward-to localhost:3000/api/webhooks/stripe",
    "stripe:listen:appointments": "stripe listen --events checkout.session.completed,checkout.session.async_payment_succeeded,checkout.session.async_payment_failed,checkout.session.expired,payment_intent.payment_failed,charge.refunded --forward-to localhost:3000/api/webhooks/stripe/appointment-funding"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
